{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Omid-NextAI/nextops/blob/main/deploy/inference/inference-artifact.schema.json",
  "title": "NextOps local inference evaluation artifact",
  "description": "Source identity, observed build/import evidence, and remaining deployment constraints; validation does not prove production acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_revision",
    "status",
    "runtime",
    "model",
    "deployment_profile",
    "evidence",
    "unresolved_gates",
    "references"
  ],
  "properties": {
    "$schema": {"const": "./inference-artifact.schema.json"},
    "schema_version": {"const": "1.2.0"},
    "manifest_revision": {"type": "string", "format": "date"},
    "status": {"const": "controlled_service_qualified_not_production_accepted"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_repository", "source_tag", "source_commit", "license", "build_target", "binary_sha256", "build_status"],
      "properties": {
        "name": {"const": "llama.cpp"},
        "source_repository": {"const": "https://github.com/ggml-org/llama.cpp"},
        "source_tag": {"const": "v0.4.1"},
        "source_commit": {"const": "b29c606e28a01b1bc8c1351026a0fa6e616bf6c4"},
        "license": {"const": "MIT"},
        "build_target": {"const": "llama-server"},
        "binary_sha256": {"const": "dbe5a5cdd4842fe2d498270c1e1df58344e9052e97214e2ba9c9845443a1b0dc"},
        "build_status": {"const": "built_cpu_native_openblas_promoted"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "source_repository", "source_revision", "artifact_commit", "filename", "quantization", "size_bytes", "sha256", "license", "native_context_tokens", "import_status"],
      "properties": {
        "model_id": {"const": "nextops-qwen3-8b-q4-k-m"},
        "source_repository": {"const": "https://huggingface.co/Qwen/Qwen3-8B-GGUF"},
        "source_revision": {"const": "7c41481f57cb95916b40956ab2f0b139b296d974"},
        "artifact_commit": {"const": "6a569868d07d3bd59e8b97fb001bf8c0b254bb20"},
        "filename": {"const": "Qwen3-8B-Q4_K_M.gguf"},
        "quantization": {"const": "Q4_K_M"},
        "size_bytes": {"const": 5027783488},
        "sha256": {"const": "d98cdcbd03e17ce47681435b5150e34c1417f50b5c0019dd560e4882c5745785"},
        "license": {"const": "Apache-2.0"},
        "native_context_tokens": {"const": 32768},
        "import_status": {"const": "promoted_sha256_verified"}
      }
    },
    "deployment_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind_host", "cpu_only_required", "runtime_internet_allowed", "configured_context_tokens", "max_output_tokens", "max_active_requests", "max_queued_requests", "disabled_features"],
      "properties": {
        "bind_host": {"const": "127.0.0.1"},
        "cpu_only_required": {"const": true},
        "runtime_internet_allowed": {"const": false},
        "configured_context_tokens": {"const": 8192},
        "max_output_tokens": {"const": 1024},
        "max_active_requests": {"const": 1},
        "max_queued_requests": {"const": 2},
        "disabled_features": {
          "type": "array",
          "const": ["accelerator_offload", "agent", "context_shift", "mcp", "remote_model_resolution", "tools", "web_ui"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_metadata_verified", "runtime_binary_built", "model_imported", "cpu_only_execution_verified", "controlled_service_installed", "application_source_commit", "authentication_readiness_verified", "bilingual_quality_review_passed", "bounded_load_run", "cold_process_restart_verified", "application_rollback_verified", "benchmark_run", "offline_cold_start_verified"],
      "properties": {
        "source_metadata_verified": {"const": true},
        "runtime_binary_built": {"const": true},
        "model_imported": {"const": true},
        "cpu_only_execution_verified": {"const": true},
        "controlled_service_installed": {"const": true},
        "application_source_commit": {"const": "62de8d61fb4a841f016732815f75d95ca6c403a9"},
        "authentication_readiness_verified": {"const": true},
        "bilingual_quality_review_passed": {"const": true},
        "bounded_load_run": {"const": true},
        "cold_process_restart_verified": {"const": true},
        "application_rollback_verified": {"const": true},
        "benchmark_run": {"const": false},
        "offline_cold_start_verified": {"const": true}
      }
    },
    "unresolved_gates": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 12}
    },
    "references": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    }
  }
}

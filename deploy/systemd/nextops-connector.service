[Unit]
Description=NextOps read-only Zabbix connector
Documentation=https://github.com/Omid-NextAI/nextops
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/srv/nextops/releases/current/venv/bin/uvicorn
ConditionPathExists=/etc/nextops/nextops-connector.env
ConditionPathExists=/etc/nextops/tls/zabbix-ca.crt
ConditionPathExists=/etc/nextops/linux-targets.json
ConditionPathExists=/etc/nextops/ssh/linux_known_hosts

[Service]
Type=simple
User=nextops-connector
Group=nextops-connector
UMask=0027
LoadCredential=zabbix-api-token:/etc/nextops/credentials/zabbix-api-token
LoadCredential=connector-service-secret:/etc/nextops/credentials/connector-service-secret
LoadCredential=linux-app-key:/etc/nextops/credentials/linux-app-key
LoadCredential=linux-ai-key:/etc/nextops/credentials/linux-ai-key
LoadCredential=linux-connector-key:/etc/nextops/credentials/linux-connector-key
LoadCredential=linux-zabbix-key:/etc/nextops/credentials/linux-zabbix-key
EnvironmentFile=/etc/nextops/nextops-connector.env
Environment=HOME=/var/lib/nextops/connector
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
ExecStart=/srv/nextops/releases/current/venv/bin/uvicorn \
    nextops.connectors.api:create_runtime_connector_app \
    --factory \
    --host 127.0.0.1 \
    --port 8100 \
    --workers 1 \
    --no-access-log \
    --no-server-header \
    --no-proxy-headers
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed
LimitCORE=0
LimitNOFILE=1024
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
CPUQuota=100%
MemoryHigh=256M
MemoryMax=384M
TasksMax=48
RuntimeDirectory=nextops-connector
RuntimeDirectoryMode=0750
StateDirectory=nextops/connector
StateDirectoryMode=0750
LogsDirectory=nextops
LogsDirectoryMode=0750
ReadOnlyPaths=/srv/nextops/releases /etc/nextops
ReadWritePaths=/var/lib/nextops/connector /var/log/nextops
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nextops-connectors-ro

[Install]
WantedBy=multi-user.target

# Non-secret read-only connector settings. Secrets use systemd LoadCredential.
NEXTOPS_ZABBIX_API_URL=https://zabbix-server/api_jsonrpc.php
NEXTOPS_ZABBIX_CA_FILE=/etc/nextops/tls/zabbix-ca.crt
NEXTOPS_ZABBIX_HOST=Zabbix server
NEXTOPS_CONNECTOR_TIMEOUT_SECONDS=15
NEXTOPS_INCIDENT_LOOKBACK_MINUTES=60
PYTHONUNBUFFERED=1
NO_PROXY=*
no_proxy=*

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextops.local/schemas/release-status.schema.json",
  "title": "NextOps controlled release status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_identifier",
    "observed_at",
    "deployment_status",
    "repository",
    "components",
    "capabilities",
    "acceptance_gates"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "release_identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "observed_at": {"type": "string", "format": "date"},
    "deployment_status": {
      "const": "controlled_user_testing_not_production_accepted"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "branch", "inspected_baseline_commit"],
      "properties": {
        "remote": {"const": "Omid-NextAI/nextops"},
        "branch": {"const": "main"},
        "inspected_baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "connector",
        "inference_api",
        "inference_runtime",
        "model",
        "application_database",
        "zabbix_database",
        "zabbix"
      ],
      "properties": {
        "application": {"$ref": "#/$defs/releaseComponent"},
        "connector": {"$ref": "#/$defs/releaseComponent"},
        "inference_api": {"$ref": "#/$defs/releaseComponent"},
        "inference_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "source_tag", "source_commit", "binary_sha256", "cpu_only"],
          "properties": {
            "name": {"const": "llama.cpp"},
            "source_tag": {"type": "string", "minLength": 1},
            "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "binary_sha256": {"$ref": "#/$defs/sha256"},
            "cpu_only": {"const": true}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "source_revision", "quantization", "size_bytes", "sha256"],
          "properties": {
            "identifier": {"type": "string", "minLength": 1},
            "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "quantization": {"type": "string", "minLength": 1},
            "size_bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "application_database": {"$ref": "#/$defs/versionedComponent"},
        "zabbix_database": {"$ref": "#/$defs/versionedComponent"},
        "zabbix": {"$ref": "#/$defs/versionedComponent"}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "acceptance_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "releaseComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "source_commit"],
      "properties": {
        "release": {"type": "string", "pattern": "^nextops-[0-9]+\\.[0-9]+\\.[0-9]+-[0-9a-f]{7}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      }
    },
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"}
      }
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^(?:docs|deploy|tests|packages)/[^\\r\\n]+$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "status": {
          "enum": ["implemented_unaccepted", "accepted_controlled", "experimental"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidencePath"}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "status": {"enum": ["passed", "partial", "not_run", "failed"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidencePath"}
        }
      }
    }
  }
}
